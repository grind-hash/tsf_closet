{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:md": "prettier --write \"**/*.{md,mdx}\"",
    "format:md:check": "prettier --check \"**/*.{md,mdx}\"",
