    "@fontsource/roboto-mono": "^5.2.8",
    "@pixiv/three-vrm": "^3.5.5",
    "@xyflow/react": "^12.10.1",
    "i18next": "^25.8.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^7.13.0",
    "react-sketch-canvas": "^6.2.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
