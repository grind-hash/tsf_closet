<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{TITLE}}</title>
    <link rel="stylesheet" href="assets/style.css">
    <script src="assets/view.js" defer></script>
  </head>
  <body>
    <header class="site-header">
      <h1>{{HEADER}}</h1>
      <p class="site-header__meta">Messages: {{MESSAGE_COUNT}}</p>
      <div class="view-switcher" role="tablist" aria-label="表示切り替え">
        <button
          id="chat-tab"
          class="view-switcher__button view-switcher__button--active"
          type="button"
          role="tab"
          aria-selected="true"
          aria-controls="chat-view"
          data-view-target="chat-view"
        >チャット</button>
        <button
          id="paired-tab"
          class="view-switcher__button"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="paired-view"
          data-view-target="paired-view"
          tabindex="-1"
        >画像＋心境</button>
      </div>
    </header>
    <main>
      <section
        id="chat-view"
        class="view-panel chat-log"
        role="tabpanel"
        aria-labelledby="chat-tab"
      >
{{CHAT_BODY}}
      </section>
      <section
        id="paired-view"
        class="view-panel paired-log"
        role="tabpanel"
        aria-labelledby="paired-tab"
        hidden
      >
{{PAIRED_BODY}}
      </section>
    </main>
    <footer class="site-footer">
      <p>Generated by TSF Closet</p>
    </footer>
  </body>
</html>
