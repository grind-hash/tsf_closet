OPENROUTER_API_KEY=

# NovelAIを利用する場合
NOVELAI_API_KEY=

# TypeSafe AI (判定モデル Jev) を直接利用する場合
TYPESAFE_API_KEY=

# プロンプトを確認する機能
ENABLE_PROMPT_PREVIEW=false

# キャラチャット: セレナが使う現実世界の情報 (任意。設定画面のトグルをONにしたときだけ使う)
# Web検索 (Tavily) のAPIキー。未設定ならWeb検索は使わない (検索1回につき1クレジット消費)
TAVILY_API_KEY=
# 天気を取得する都市名 (例: Tokyo)。Open-Meteoを使うためAPIキーは不要。未設定なら天気は使わない
WEATHER_LOCATION=

# 画像生成プロバイダー設定
# selfhost: ComfyUI (デフォルト), openrouter: OpenRouter API, novelai: NovelAI Image API
IMAGE_PROVIDER=selfhost
# OpenRouter画像生成設定 (IMAGE_PROVIDER=openrouter時に使用)
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
OPENROUTER_IMAGE_TIMEOUT=120
# NovelAI画像生成設定 (IMAGE_PROVIDER=novelai時に使用)
NOVELAI_MODEL=nai-diffusion-4-5-full
NOVELAI_INPAINT_MODEL=nai-diffusion-4-5-full-inpainting

# 主に非nsfwモード向け
NOVELAI_CURATED_MODEL=nai-diffusion-4-5-curated
NOVELAI_CURATED_INPAINT_MODEL=nai-diffusion-4-5-curated-inpainting

NOVELAI_INPAINT_ACTION=infill
NOVELAI_SIZE=portrait
NOVELAI_STEPS=28
NOVELAI_SCALE=5.0
NOVELAI_UC_PRESET=light
NOVELAI_NEGATIVE_PROMPT=lowres, bad anatomy, bad hands, text, logo, watermark, blurry, extra digits, deformed
NOVELAI_I2I_STRENGTH=0.9
NOVELAI_I2I_NOISE=0.0

# 画像説明プロバイダー設定
# selfhost: LiteLLM Proxy (デフォルト), openrouter: OpenRouter API, novelai: NovelAI (Vision LLMスキップ)
IMAGE_DESCRIPTION_PROVIDER=selfhost
# 心境生成プロバイダー設定
# selfhost: ComfyUI (デフォルト), openrouter: OpenRouter API, novelai: NovelAI GLM-4.6
FEELING_PROVIDER=selfhost

# ============================================
# NovelAI Opusモード設定
# ============================================
# 以下の3つをすべて "novelai" に設定すると、NovelAI Opusモードが有効になります。
# Vision LLMを使用せず、生成プロンプトを心境生成の入力として再利用します。
# IMAGE_PROVIDER=novelai
# IMAGE_DESCRIPTION_PROVIDER=novelai
# FEELING_PROVIDER=novelai
# OpenRouter LLM設定 (上記=openrouter時に使用)
OPENROUTER_VISION_MODEL=google/gemini-3-flash-preview
OPENROUTER_LLM_MODEL=google/gemini-3-flash-preview
OPENROUTER_LLM_TIMEOUT=60

# ============================================
# 構造化判定 (TypeSafe AI Jev) — 実験的
# ============================================
# テキストを生成せず、型付きの質問に型付きで答える判定専用モデル。
# 性別適合判定・セレナの調べ物の必要性・変身タグ分類の精度確認に使う。
# 既定は off。ONにすると JEV_PROVIDER 側に課金されます
# (APIキーがあるだけでは使いません)。
# off / openrouter (OPENROUTER_API_KEYを流用) / typesafe (TYPESAFE_API_KEY)
JEV_PROVIDER=off
# 空なら経路ごとの既定 (openrouter: typesafe/jev-1.13, typesafe: jev-latest)
JEV_MODEL=
JEV_TIMEOUT=10
# 判定結果を実際の挙動へ反映する対象 (カンマ区切り)。
# 空ならすべてシャドー(ログに出すだけで挙動は変えない)、all ですべて反映。
# 指定できる値: congruence, chat_lookup, search_policy, tags
JEV_LIVE_TARGETS=

# ComfyUI設定 (セルフホスト)
COMFYUI_BASE_URL=http://localhost:8188
COMFYUI_WORKFLOW_PATH=workflows/qwen_image_edit_template_local.json
# COMFYUI_WORKFLOW_PATH=workflows/qwen_image_edit_template_local_nsfw.json
# 背景など編集元画像なしの生成に使う txt2img ワークフロー
# (未設定なら COMFYUI_WORKFLOW_PATH の image_edit を image_txt2img に置き換えたファイルを使う)
# COMFYUI_TXT2IMG_WORKFLOW_PATH=workflows/qwen_image_txt2img_template_local.json
COMFYUI_CLIENT_ID=tsf_closet
COMFYUI_REQUEST_TIMEOUT=300

# LiteLLM Proxy設定 (セルフホスト)
LITELLM_API_KEY=
LITELLM_BASE_URL=http://localhost:4000
# セルフホスト: 画像説明モデル
LITELLM_LLAVA_MODEL=ollama/ministral-3:14b-instruct-2512-q4_K_M
LITELLM_LLM_MODEL=ollama/ministral-3:14b-instruct-2512-q4_K_M

# セルフホスト: 心理状態生成用モデル
LITELLM_FEELING_MODEL=ollama/ministral-3:14b-instruct-2512-q4_K_M

LITELLM_REQUEST_TIMEOUT=300

# キャラクター設定
CHARACTERS_DIR=images/characters
LOG_LEVEL=DEBUG
