# ============================================
# 構造化判定 (TypeSafe AI Jev) を試すときの設定
# ============================================
# Jev はテキストを生成しない判定専用モデルで、state (評価対象) と型付きの質問を
# 送ると型付きの答えを返す。生成プロバイダー (IMAGE_PROVIDER / FEELING_PROVIDER /
# IMAGE_DESCRIPTION_PROVIDER) とは独立した軸なので、どの構成にも足せる。
#
# 既定は off。ONにすると選んだ経路に課金される (APIキーがあるだけでは使わない)。
# まずは JEV_LIVE_TARGETS を空のままにして、ログの jev_shadow 行で既存の判定との
# 一致率を確かめてから、対象を1つずつ足していくこと。

# --- 経路 ---
# openrouter: OPENROUTER_API_KEY を流用し、POST /api/alpha/decisions を叩く。
#             応答に実際の料金 (usage.cost) が入るため、UIの料金表示が正確になる
# typesafe:   TYPESAFE_API_KEY で api.typesafe.ai を直接叩く。
#             料金は返らないため JEV_INPUT_PRICE_USD_PER_MTOK から推定する
JEV_PROVIDER=openrouter

OPENROUTER_API_KEY=
TYPESAFE_API_KEY=

# 空なら経路ごとの既定。計測中はバージョンを固定したほうが一致率が安定する
# (~typesafe/jev-latest はエイリアスで、指す実体が変わりうる)
JEV_MODEL=typesafe/jev-1.13
JEV_TIMEOUT=10

# --- どこまで実際の挙動に反映するか ---
# 空: すべてシャドー (ログに出すだけ。挙動は今までどおり)
# all: すべて反映
# congruence   : 性別適合判定
# chat_lookup  : セレナの調べ物 (Web検索・天気) の必要性ゲート
# search_policy: Web検索の利用規約スクリーニング
# tags         : 変身タグ分類 (露出度は羞恥・開花の増減に影響する)
JEV_LIVE_TARGETS=

# --- しきい値 ---
# 真偽確率(noul)の判断不能帯。この外側だけを結論として採用する
JEV_HIGH=0.7
JEV_LOW=0.3
# choice / score を採用する最低 confidence。未満は unknown 扱い
JEV_MIN_CONFIDENCE=0.5

# TypeSafe を直接叩くときの推定単価 (USD / 1M input tokens)。公表値は 0.042
JEV_INPUT_PRICE_USD_PER_MTOK=0.042
