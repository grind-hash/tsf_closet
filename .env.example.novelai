# NovelAIを利用する場合
NOVELAI_API_KEY=your_api_key_here

# プロンプトを確認する機能
ENABLE_PROMPT_PREVIEW=false

# 現実世界コンテキスト (ENABLE_PROMPT_PREVIEW=true のときだけ有効)
# Web 検索 (Tavily) の API キー。未設定なら Web 検索は使わない
TAVILY_API_KEY=
# 天気を取得する都市名 (例: Tokyo)。Open-Meteo を使うため API キーは不要。未設定なら天気は使わない
WEATHER_LOCATION=

# ============================================
# NovelAI Opusモード設定
# ============================================
# 以下の3つをすべて "novelai" に設定すると、NovelAI Opusモードが有効になります。
# Vision LLMを使用せず、生成プロンプトを心境生成の入力として再利用します。
IMAGE_PROVIDER=novelai
IMAGE_DESCRIPTION_PROVIDER=novelai
FEELING_PROVIDER=novelai

# NovelAI画像生成設定 (IMAGE_PROVIDER=novelai時に使用)
NOVELAI_MODEL=nai-diffusion-4-5-full
NOVELAI_INPAINT_MODEL=nai-diffusion-4-5-full-inpainting

# 主に非nsfwモード向け
NOVELAI_CURATED_MODEL=nai-diffusion-4-5-curated
NOVELAI_CURATED_INPAINT_MODEL=nai-diffusion-4-5-curated-inpainting

NOVELAI_INPAINT_ACTION=infill
NOVELAI_SIZE=portrait
NOVELAI_STEPS=28
NOVELAI_SCALE=5.0
NOVELAI_UC_PRESET=light
NOVELAI_NEGATIVE_PROMPT=lowres, bad anatomy, bad hands, text, logo, watermark, blurry, extra digits, deformed
NOVELAI_I2I_STRENGTH=0.9
NOVELAI_I2I_NOISE=0.0

# キャラクター設定
CHARACTERS_DIR=images/characters
LOG_LEVEL=INFO
