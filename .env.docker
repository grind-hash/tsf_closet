# プロバイダーとしてOpenRouterを利用する場合のAPIキー
OPENROUTER_API_KEY=

# NovelAIを利用する場合
NOVELAI_API_KEY=

# プロンプトを確認する機能
ENABLE_PROMPT_PREVIEW=true

# 現実世界コンテキスト (ENABLE_PROMPT_PREVIEW=true のときだけ有効)
# Web 検索 (Tavily) の API キー。未設定なら Web 検索は使わない
TAVILY_API_KEY=
# 天気を取得する都市名 (例: Tokyo)。Open-Meteo を使うため API キーは不要。未設定なら天気は使わない
WEATHER_LOCATION=

# LiteLLM Proxy設定 (セルフホスト)
LITELLM_BASE_URL=http://litellm:4000
LITELLM_REQUEST_TIMEOUT=600
LITELLM_API_KEY=sk-1234

#------------------------------------------------------------------
# 画像生成プロバイダー設定
# selfhost: ComfyUI (デフォルト), openrouter: OpenRouter API
#------------------------------------------------------------------
# IMAGE_PROVIDER=openrouter
# OpenRouter画像生成設定 (IMAGE_PROVIDER=openrouter時に使用)
# OPENROUTER_IMAGE_MODEL=google/gemini-3-flash-preview
# OPENROUTER_IMAGE_TIMEOUT=120

# NovelAI画像生成設定 (IMAGE_PROVIDER=novelai時に使用)
NOVELAI_MODEL=nai-diffusion-4-5-full
NOVELAI_INPAINT_MODEL=nai-diffusion-4-5-full-inpainting
NOVELAI_INPAINT_ACTION=infill

# 主に非nsfwモード向け
NOVELAI_CURATED_MODEL=nai-diffusion-4-5-curated
NOVELAI_CURATED_INPAINT_MODEL=nai-diffusion-4-5-curated-inpainting

NOVELAI_SIZE=portrait
NOVELAI_STEPS=28
NOVELAI_SCALE=5.0
NOVELAI_UC_PRESET=light
NOVELAI_NEGATIVE_PROMPT=lowres, bad anatomy, bad hands, text, logo, watermark, blurry, extra digits, deformed
NOVELAI_I2I_STRENGTH=0.9
NOVELAI_I2I_NOISE=0.0

# ComfyUI画像生成設定 (IMAGE_PROVIDER=selfhost時に使用)
COMFYUI_BASE_URL=http://comfyui:8188
COMFYUI_WORKFLOW_PATH=workflows/qwen_image_edit_template_local.json
# COMFYUI_WORKFLOW_PATH=workflows/qwen_image_edit_template_local_nsfw.json
# 背景など編集元画像なしの生成に使う txt2img ワークフロー
# (未設定なら COMFYUI_WORKFLOW_PATH の image_edit を image_txt2img に置き換えたファイルを使う)
# COMFYUI_TXT2IMG_WORKFLOW_PATH=workflows/qwen_image_txt2img_template_local.json
COMFYUI_CLIENT_ID=wakuwaku_transform
COMFYUI_REQUEST_TIMEOUT=600

#------------------------------------------------------------------
# 画像説明プロバイダー設定
# selfhost: LiteLLM Proxy (デフォルト), openrouter: OpenRouter API
# IMAGE_DESCRIPTION_PROVIDER=openrouter
#------------------------------------------------------------------
# OpenRouter LLM設定 (上記=openrouter時に使用)
# OPENROUTER_VISION_MODEL=google/gemini-3-flash-preview

# 画像説明 LLM設定 (上記=selfhost時に使用)
LITELLM_LLAVA_MODEL=ollama/ministral-3:3b-instruct-2512-q4_K_M

#------------------------------------------------------------------
# 心理状態プロバイダー設定
# selfhost: LiteLLM Proxy (デフォルト), openrouter: OpenRouter API
# FEELING_PROVIDER=openrouter
#------------------------------------------------------------------
# OPENROUTER_LLM_MODEL=google/gemini-3-flash-preview
# OPENROUTER_LLM_TIMEOUT=60

# 心理状態プロバイダー設定 (上記=selfhost時に使用)
LITELLM_FEELING_MODEL=ollama/ministral-3:3b-instruct-2512-q4_K_M
LITELLM_LLM_MODEL=ollama/ministral-3:3b-instruct-2512-q4_K_M


# キャラクター設定
CHARACTERS_DIR=images/characters
LOG_LEVEL=INFO
