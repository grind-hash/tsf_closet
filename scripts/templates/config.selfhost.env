# ============================================
#   TSF Closet - selfhost (ComfyUI + LiteLLM) 設定
# ============================================
# ローカルの ComfyUI と LiteLLM Proxy を使用する構成です。
# ComfyUI と LiteLLM が起動済みであることを確認してください。

# === プロバイダー設定 ===
IMAGE_PROVIDER=selfhost
IMAGE_DESCRIPTION_PROVIDER=selfhost
FEELING_PROVIDER=selfhost

# === ComfyUI 接続設定 ===
COMFYUI_BASE_URL=http://127.0.0.1:8188
# GGUF (Q2_K) 版の拡散モデルを前提としたワークフローを指定する。
# ComfyUI に ComfyUI-GGUF カスタムノード (UnetLoaderGGUF) と
# qwen-image-edit-2511-Q2_K.gguf / Qwen-Rapid-NSFW-v23_Q2_K.gguf が必要。
# 量子化していないモデルを使う場合は、末尾に _gguf の無いワークフローを指定する
COMFYUI_WORKFLOW_PATH=workflows/qwen_image_edit_template_local_gguf.json
# 背景など編集元画像なしの生成に使う txt2img ワークフロー
# (未設定なら COMFYUI_WORKFLOW_PATH の image_edit を image_txt2img に置き換えたファイルを使う)
# COMFYUI_TXT2IMG_WORKFLOW_PATH=workflows/qwen_image_txt2img_template_local_gguf.json
# 着せ替えゲームのワークフロー (未設定なら NSFW 設定に応じて同梱の
# qwen_image_edit_template_local.json / qwen_image_edit_template_local_nsfw.json を使う)
COMFYUI_GAME_WORKFLOW_PATH=workflows/qwen_image_edit_template_local_gguf.json
COMFYUI_GAME_NSFW_WORKFLOW_PATH=workflows/qwen_image_edit_template_local_nsfw_gguf.json
COMFYUI_CLIENT_ID=my_closet
COMFYUI_REQUEST_TIMEOUT=1800

# === LiteLLM Proxy 接続設定 ===
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_API_KEY=your_api_key_here

# セルフホスト: 画像説明モデル
LITELLM_LLAVA_MODEL=ministral-3:3b-instruct-2512-q4_K_M
LITELLM_LLM_MODEL=ministral-3:3b-instruct-2512-q4_K_M

# セルフホスト: 心理状態生成用モデル
LITELLM_FEELING_MODEL=ministral-3:3b-instruct-2512-q4_K_M
LITELLM_REQUEST_TIMEOUT=1800