# ============================================
#   TSF Closet 共通設定
# ============================================
# このファイルは全プロバイダー共通の設定です。
# プロバイダー固有の設定は config.{provider}.env から自動マージされます。

# === サーバー設定 ===
PORT=8000
LOG_LEVEL=info

# === キャラチャット: 現実世界の情報 (任意) ===
# セレナが使う。設定画面のトグルをONにしたときだけ使う
# Web検索 (Tavily) のAPIキー。未設定ならWeb検索は使わない (検索1回につき1クレジット消費)
TAVILY_API_KEY=
# 天気を取得する都市名 (例: Tokyo)。Open-Meteoを使うためAPIキーは不要。未設定なら天気は使わない
WEATHER_LOCATION=
