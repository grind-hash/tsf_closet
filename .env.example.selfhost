# 画像生成プロバイダー設定
IMAGE_PROVIDER=selfhost

# 画像説明プロバイダー設定
IMAGE_DESCRIPTION_PROVIDER=selfhost

# 心境生成プロバイダー設定
FEELING_PROVIDER=selfhost

# ComfyUI設定 (セルフホスト)
COMFYUI_BASE_URL=http://localhost:8188
COMFYUI_WORKFLOW_PATH=workflows/qwen_image_edit_template_local_nsfw.json
# 背景など編集元画像なしの生成に使う txt2img ワークフロー
# (未設定なら COMFYUI_WORKFLOW_PATH の image_edit を image_txt2img に置き換えたファイルを使う)
# COMFYUI_TXT2IMG_WORKFLOW_PATH=workflows/qwen_image_txt2img_template_local_nsfw.json
COMFYUI_CLIENT_ID=tsf_closet
COMFYUI_REQUEST_TIMEOUT=600

# LiteLLM Proxy設定 (セルフホスト)
LITELLM_API_KEY=your_api_key_here
LITELLM_BASE_URL=http://localhost:4000

# セルフホスト: 画像説明モデル
LITELLM_LLAVA_MODEL=gemma4:e4b
LITELLM_LLM_MODEL=gemma4:e4b

# セルフホスト: 心理状態生成用モデル
LITELLM_FEELING_MODEL=gemma4:e4b

LITELLM_REQUEST_TIMEOUT=600

# プロンプトを確認する機能
ENABLE_PROMPT_PREVIEW=false
# 現実世界コンテキスト (ENABLE_PROMPT_PREVIEW=true のときだけ有効)
# Web 検索 (Tavily) の API キー。未設定なら Web 検索は使わない
TAVILY_API_KEY=
# 天気を取得する都市名 (例: Tokyo)。Open-Meteo を使うため API キーは不要。未設定なら天気は使わない
WEATHER_LOCATION=

# キャラクター設定
CHARACTERS_DIR=images/characters
LOG_LEVEL=INFO
