# 画像生成プロバイダー設定
IMAGE_PROVIDER=selfhost

# 画像説明プロバイダー設定
IMAGE_DESCRIPTION_PROVIDER=selfhost

# 心境生成プロバイダー設定
FEELING_PROVIDER=selfhost

# ComfyUI設定 (セルフホスト)
COMFYUI_BASE_URL=http://localhost:8188
# Docker 版 ComfyUI が既定でダウンロードするのは GGUF (Q2_K) 版の拡散モデルのため、
# ワークフローも GGUF 版 (*_gguf.json) を指定する。量子化していないモデルを使う場合は
# docker/comfyui/entrypoint.sh でダウンロードを有効にし、末尾に _gguf の無いワークフローを指定する
COMFYUI_WORKFLOW_PATH=workflows/qwen_image_edit_template_local_nsfw_gguf.json
# 背景など編集元画像なしの生成に使う txt2img ワークフロー
# (未設定なら COMFYUI_WORKFLOW_PATH の image_edit を image_txt2img に置き換えたファイルを使う)
# COMFYUI_TXT2IMG_WORKFLOW_PATH=workflows/qwen_image_txt2img_template_local_nsfw_gguf.json
# 着せ替えゲームのワークフロー (未設定なら NSFW 設定に応じて同梱の
# qwen_image_edit_template_local.json / qwen_image_edit_template_local_nsfw.json を使う)
COMFYUI_GAME_WORKFLOW_PATH=workflows/qwen_image_edit_template_local_gguf.json
COMFYUI_GAME_NSFW_WORKFLOW_PATH=workflows/qwen_image_edit_template_local_nsfw_gguf.json
COMFYUI_CLIENT_ID=tsf_closet
COMFYUI_REQUEST_TIMEOUT=1800

# LiteLLM Proxy設定 (セルフホスト)
LITELLM_API_KEY=your_api_key_here
LITELLM_BASE_URL=http://localhost:4000

# セルフホスト: 画像説明モデル
LITELLM_LLAVA_MODEL=ministral-3:3b-instruct-2512-q4_K_M
LITELLM_LLM_MODEL=ministral-3:3b-instruct-2512-q4_K_M

# セルフホスト: 心理状態生成用モデル
LITELLM_FEELING_MODEL=ministral-3:3b-instruct-2512-q4_K_M

LITELLM_REQUEST_TIMEOUT=1800

# キャラチャット: セレナが使う現実世界の情報 (任意。設定画面のトグルをONにしたときだけ使う)
# Web検索 (Tavily) のAPIキー。未設定ならWeb検索は使わない (検索1回につき1クレジット消費)
TAVILY_API_KEY=
# 天気を取得する都市名 (例: Tokyo)。Open-Meteoを使うためAPIキーは不要。未設定なら天気は使わない
WEATHER_LOCATION=

# キャラクター設定
CHARACTERS_DIR=images/characters
LOG_LEVEL=INFO

# TypeSafe AI (判定モデル Jev) を直接利用する場合
TYPESAFE_API_KEY=
# 構造化判定 (TypeSafe AI Jev)。既定 off。詳細は .env.example.jev を参照
JEV_PROVIDER=off
JEV_LIVE_TARGETS=
