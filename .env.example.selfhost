# 画像生成プロバイダー設定
IMAGE_PROVIDER=selfhost

# 画像説明プロバイダー設定
IMAGE_DESCRIPTION_PROVIDER=selfhost

# 心境生成プロバイダー設定
FEELING_PROVIDER=selfhost

# ComfyUI設定 (セルフホスト)
COMFYUI_BASE_URL=http://localhost:8188
COMFYUI_WORKFLOW_PATH=workflows/qwen_image_edit_template_local_nsfw.json
COMFYUI_CLIENT_ID=tsf_closet
COMFYUI_REQUEST_TIMEOUT=600

# LiteLLM Proxy設定 (セルフホスト)
LITELLM_API_KEY=your_api_key_here
LITELLM_BASE_URL=http://localhost:4000

# セルフホスト: 画像説明モデル
LITELLM_LLAVA_MODEL=ollama/ministral-3:3b-instruct-2512-q4_K_M
LITELLM_LLM_MODEL=ollama/ministral-3:3b-instruct-2512-q4_K_M

# セルフホスト: 心理状態生成用モデル
LITELLM_FEELING_MODEL=ollama/ministral-3:3b-instruct-2512-q4_K_M

LITELLM_REQUEST_TIMEOUT=600

# キャラクター設定
CHARACTERS_DIR=images/characters
LOG_LEVEL=INFO
