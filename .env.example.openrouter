# OpenRouter APIキー
OPENROUTER_API_KEY=your_api_key_here

# 画像生成プロバイダー設定
IMAGE_PROVIDER=openrouter
# OpenRouter画像生成設定
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# 画像説明プロバイダー設定
IMAGE_DESCRIPTION_PROVIDER=openrouter
# OpenRouter画像説明設定
OPENROUTER_VISION_MODEL=mistralai/ministral-14b-2512

# 心境生成プロバイダー設定
FEELING_PROVIDER=openrouter
# OpenRouter心境説明設定
OPENROUTER_LLM_MODEL=x-ai/grok-4.3

OPENROUTER_LLM_TIMEOUT=60
OPENROUTER_IMAGE_TIMEOUT=120

# キャラチャット: セレナが使う現実世界の情報 (任意。設定画面のトグルをONにしたときだけ使う)
# Web検索 (Tavily) のAPIキー。未設定ならWeb検索は使わない (検索1回につき1クレジット消費)
TAVILY_API_KEY=
# 天気を取得する都市名 (例: Tokyo)。Open-Meteoを使うためAPIキーは不要。未設定なら天気は使わない
WEATHER_LOCATION=

LOG_LEVEL=INFO
