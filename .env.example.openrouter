# OpenRouter APIキー
OPENROUTER_API_KEY=your_api_key_here

# 画像生成プロバイダー設定
IMAGE_PROVIDER=openrouter
# OpenRouter画像生成設定
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# 画像説明プロバイダー設定
IMAGE_DESCRIPTION_PROVIDER=openrouter
# OpenRouter画像説明設定
OPENROUTER_VISION_MODEL=mistralai/ministral-14b-2512

# 心境生成プロバイダー設定
FEELING_PROVIDER=openrouter
# OpenRouter心境説明設定
OPENROUTER_LLM_MODEL=x-ai/grok-4.3

OPENROUTER_LLM_TIMEOUT=60
OPENROUTER_IMAGE_TIMEOUT=120

# プロンプトを確認する機能
ENABLE_PROMPT_PREVIEW=false
# 現実世界コンテキスト (ENABLE_PROMPT_PREVIEW=true のときだけ有効)
# Web 検索 (Tavily) の API キー。未設定なら Web 検索は使わない
TAVILY_API_KEY=
# 天気を取得する都市名 (例: Tokyo)。Open-Meteo を使うため API キーは不要。未設定なら天気は使わない
WEATHER_LOCATION=

LOG_LEVEL=INFO
